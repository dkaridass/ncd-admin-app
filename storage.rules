rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Get the User Document to check roles (Requires Firebase Storage linked to Firestore)
    function getUserData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isSuperAdmin() { return hasRole('SUPER_ADMIN'); }
    function isPastor() { return hasRole('PASTOR'); }
    function isStaffAdmin() { return hasRole('STAFF_ADMIN'); }
    function isDeptLeader() { return hasRole('DEPT_LEADER'); }
    function isSecretary() { return hasRole('SECRETARY'); }
    
    function isInternalStaff() {
      return isSuperAdmin() || isPastor() || isStaffAdmin() || isSecretary() || isDeptLeader();
    }

    // Department Reports - authenticated internal staff can read/write
    match /departmentReports/{allPaths=**} {
      allow read: if isInternalStaff();
      allow write: if isInternalStaff();
    }

    // General uploads (logos, etc.) - authenticated users can read, only internal staff can write
    match /uploads/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isInternalStaff();
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
