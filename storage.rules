rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Department Reports - authenticated users can read/write
    match /departmentReports/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // General uploads (logos, etc.) - authenticated users can read, admins can write
    match /uploads/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
