rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null ? userDoc.data : {'role': 'VIEWER'};
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isSuperAdmin()   { return hasRole('SUPER_ADMIN'); }
    function isPastor()       { return hasRole('PASTOR'); }
    function isFinanceAdmin() { return hasRole('FINANCE_ADMIN'); }
    function isStaffAdmin()   { return hasRole('STAFF_ADMIN'); }
    function isDeptLeader()   { return hasRole('DEPT_LEADER'); }
    function isSecretary()    { return hasRole('SECRETARY'); }

    function isInternalStaff() {
      return isSuperAdmin() || isPastor() || isStaffAdmin() || isSecretary() || isDeptLeader();
    }

    function canManageReports() {
      return isSuperAdmin() || isPastor() || isStaffAdmin();
    }

    // --- Collections ---

    // 1. Users
    match /users/{userId} {
      allow read: if isInternalStaff() || request.auth.uid == userId;
      allow write: if isSuperAdmin() || request.auth.uid == userId;
    }

    // 2. Members
    match /members/{memberId} {
      allow read: if isInternalStaff();
      allow write: if isSuperAdmin() || isPastor() || isStaffAdmin() || isSecretary();
    }

    // 3. Departments
    match /departments/{deptId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
      allow update: if isDeptLeader() && getUserData().departmentId == deptId;
    }

    // 4. Finance
    match /finances/{financeId} {
      allow read, write: if isSuperAdmin() || isFinanceAdmin() || isStaffAdmin();
    }

    // 5. Events
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isPastor() || isStaffAdmin();
    }

    // 6. Attendance
    match /attendance/{recordId} {
      allow read: if isInternalStaff();
      allow write: if isSuperAdmin() || isPastor() || isStaffAdmin();
    }

    // 7. Prayer Requests
    match /prayer_requests/{requestId} {
      allow read: if isSuperAdmin() || isPastor()
                  || request.auth.uid == resource.data.authorId
                  || (isAuthenticated() && resource.data.isPrivate == false);
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin() || isPastor() || request.auth.uid == resource.data.authorId;
    }

    // 8. Department Reports
    match /departmentReports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isInternalStaff();
      allow update, delete: if canManageReports();
    }

    // 9. Department Chat — FIX: was missing entirely
    match /departmentChat/{messageId} {
      allow read: if isInternalStaff();
      allow create: if isInternalStaff();
      allow update, delete: if isSuperAdmin() || isPastor() || isStaffAdmin();
    }

    // 10. AI / Pastoral content
    match /rhema/{rhemaId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isPastor() || isStaffAdmin();
    }

    // FIX: code uses 'sermon_plans' (underscore), not 'sermonPlans'
    match /sermon_plans/{planId} {
      allow read: if isInternalStaff();
      allow write: if isSuperAdmin() || isPastor() || isStaffAdmin();
    }

    // FIX: code uses 'pastoral_briefings', not 'briefings'
    match /pastoral_briefings/{briefingId} {
      allow read: if isInternalStaff();
      allow write: if isSuperAdmin() || isPastor() || isStaffAdmin();
    }

    // 11. Weekly / Annual programme
    match /weeklyServices/{serviceId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isPastor() || isStaffAdmin();
    }
    match /annualProgramme/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isPastor() || isStaffAdmin();
    }

    // 12. App settings
    match /appSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // 13. Communications
    match /messageTemplates/{templateId} {
      allow read: if isInternalStaff();
      allow write: if isSuperAdmin() || isPastor() || isStaffAdmin();
    }
    match /communications/{messageId} {
      allow read: if isInternalStaff();
      allow write: if isSuperAdmin() || isPastor() || isStaffAdmin();
    }
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isPastor() || isStaffAdmin();
    }

    // 14. Resources & Tasks
    match /resources/{resourceId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isPastor() || isStaffAdmin();
    }
    match /tasks/{taskId} {
      allow read, write: if isInternalStaff();
    }

    // 15. Follow-ups
    match /followUps/{followUpId} {
      allow read: if isInternalStaff();
      allow write: if isSuperAdmin() || isPastor() || isStaffAdmin();
    }

    // 16. Audit / Activity Log — FIX: code writes to 'activityLog', not 'auditLogs'
    match /activityLog/{logId} {
      allow read: if isSuperAdmin() || isStaffAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Logs are append-only
    }

    // 17. Reports (generic)
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isPastor() || isStaffAdmin();
    }

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
