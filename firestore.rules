rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Get the User Document to check roles (Cost: 1 Read per request context)
    function getUserData() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null ? userDoc.data : {'role': 'VIEWER'};
    }

    // Role Check Helpers
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }
    
    function isSuperAdmin() { return hasRole('SUPER_ADMIN'); }
    function isPastor() { return hasRole('PASTOR'); }
    function isFinanceAdmin() { return hasRole('FINANCE_ADMIN'); }
    function isStaffAdmin() { return hasRole('STAFF_ADMIN'); }
    function isDeptLeader() { return hasRole('DEPT_LEADER'); }
    function isSecretary() { return hasRole('SECRETARY'); }
    function isInternalStaff() {
      return isSuperAdmin() || isPastor() || isStaffAdmin() || isSecretary() || isDeptLeader();
    }

    // --- Collection Rules ---

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isInternalStaff() || request.auth.uid == userId;
      allow write: if isSuperAdmin() || request.auth.uid == userId;
    }

    // 2. Members Collection
    match /members/{memberId} {
      // Internal staff can read all members. A normal user can't read the whole DB.
      allow read: if isInternalStaff(); 
      allow write: if isSuperAdmin() || isPastor() || isStaffAdmin() || isSecretary();
    }

    // 3. Departments
    match /departments/{deptId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
      allow update: if isDeptLeader() && getUserData().departmentId == deptId;
    }

    // 4. Finance
    match /finances/{financeId} {
      allow read, write: if isSuperAdmin() || isFinanceAdmin() || isStaffAdmin();
    }

    // 5. Events
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isPastor() || isStaffAdmin();
    }

    // 6. Attendance
    match /attendance/{recordId} {
      allow read: if isInternalStaff();
      allow write: if isSuperAdmin() || isPastor() || isStaffAdmin();
    }

    // 7. Prayer Requests
    match /prayer_requests/{requestId} {
      allow read: if isSuperAdmin() || isPastor() || request.auth.uid == resource.data.authorId || (isAuthenticated() && resource.data.isPrivate == false);
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin() || isPastor() || request.auth.uid == resource.data.authorId;
    }
    
    // AI Content: Rhema, Sermon Plans, Briefings
    match /rhema/{rhemaId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isPastor() || isStaffAdmin();
    }
    match /sermonPlans/{planId} {
      allow read: if isInternalStaff();
      allow write: if isSuperAdmin() || isPastor() || isStaffAdmin();
    }
    match /briefings/{briefingId} {
      allow read: if isInternalStaff();
      allow write: if isSuperAdmin() || isPastor() || isStaffAdmin();
    }

    // Other settings and reports
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isPastor() || isStaffAdmin();
    }
    match /departmentReports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isInternalStaff();
      allow update, delete: if isSuperAdmin() || isPastor() || isStaffAdmin();
    }
    match /weeklyServices/{serviceId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isPastor() || isStaffAdmin();
    }
    match /annualProgramme/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isPastor() || isStaffAdmin();
    }
    match /appSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
    match /messageTemplates/{templateId} {
      allow read: if isInternalStaff();
      allow write: if isSuperAdmin() || isPastor() || isStaffAdmin();
    }
    match /communications/{messageId} {
      allow read: if isInternalStaff();
      allow write: if isSuperAdmin() || isPastor() || isStaffAdmin();
    }
    match /followUps/{followUpId} {
      allow read: if isInternalStaff();
      allow write: if isSuperAdmin() || isPastor() || isStaffAdmin();
    }
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin() || isStaffAdmin();
      allow write: if isAuthenticated(); // Append-only by authorized users in cloud function ideally, but allow write for now
    }
    match /tasks/{taskId} {
      allow read, write: if isInternalStaff();
    }
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isPastor() || isStaffAdmin();
    }
    match /resources/{resourceId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isPastor() || isStaffAdmin();
    }

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
